{
	"name": "@3sixty/api-tenant-processor",
	"version": "0.20.0-next.0",
	"description": "Tenant resolution services and route handlers that derive tenant context from API keys.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/api.git",
		"directory": "packages/api-tenant-processor"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage .cache",
		"build": "tspc --incremental --tsBuildInfoFile .cache/tsconfig.tsbuildinfo",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit --incremental --tsBuildInfoFile .cache/tests.tsbuildinfo",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,merge,locales,types,test \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,merge,locales,types \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/api-models": "0.20.0-next.0",
		"@3sixty/context": "next",
		"@3sixty/core": "next",
		"@3sixty/crypto": "next",
		"@3sixty/entity": "next",
		"@3sixty/entity-storage-models": "next",
		"@3sixty/nameof": "next",
		"@3sixty/vault-models": "next",
		"@3sixty/web": "next"
	},
	"devDependencies": {
		"@3sixty/merge-locales": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/validate-locales": "next",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"node",
		"tenant",
		"foundation",
		"utilities"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/api/issues"
	},
	"homepage": "https://3sixty.global"
}
