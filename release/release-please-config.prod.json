{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch}",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"last-release-sha": "86b74e4f4248b7973b692b1f0464107b179e2de3",
	"packages": {
		"packages/api-models": {
			"package-name": "api-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-core": {
			"package-name": "api-core",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-processors": {
			"package-name": "api-processors",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-server-fastify": {
			"package-name": "api-server-fastify",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-service": {
			"package-name": "api-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-rest-client": {
			"package-name": "api-rest-client",
			"changelog-path": "docs/changelog.md"
		},
		"packages/api-tenant-processor": {
			"package-name": "api-tenant-processor",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"api-models",
				"api-core",
				"api-processors",
				"api-server-fastify",
				"api-service",
				"api-rest-client",
				"api-tenant-processor"
			]
		}
	]
}
